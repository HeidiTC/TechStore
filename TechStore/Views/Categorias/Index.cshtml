@model List<TechStore.Models.Categoria>


@{ 
    ViewData["Title"] = "Categorias"; 

}
<h2>Listado de categorias</h2>
<a asp-action="Create" class="btn btn-primary mb-3">Agregar categoria</a>
<div class="table-responsive">
<table class="table table-striped">
    <thead><tr><th>ID</th><th>Nombre</th><th>Descripción</th><th>Opciones</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ID</td><td>@item.Nombre</td><td>@item.Descripcion</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-warning btn-sm">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-danger btn-sm">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
@if (Model.Count == 0)
{
    <p>No hay registros. Utilice el botón Agregar.</p>
}
