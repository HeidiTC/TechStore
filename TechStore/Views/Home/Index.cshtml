@{
    ViewData["Title"] = "Inicio";
}
<h1>TechStore</h1>
<p>Administración de productos y categorías.</p>

@if (User.Identity?.IsAuthenticated != true)
{
    <p>Inicie sesión para consultar los productos de la tienda.</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Iniciar sesión</a>
    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary">Registrarse</a>
}
else
{
    <a asp-controller="Productos" asp-action="Index" class="btn btn-primary">Ver productos</a>
    if (User.IsInRole("Administrador"))
    {
        <a asp-controller="Categorias" asp-action="Index" class="btn btn-secondary">Ver categorías</a>

        @* Botón para demostrar la página de error personalizada y el registro del error en el log *@
        <a asp-controller="Home" asp-action="ProbarError" class="btn btn-outline-danger">Generar error de prueba</a>
    }
}
