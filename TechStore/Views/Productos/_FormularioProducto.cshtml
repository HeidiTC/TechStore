@model TechStore.Models.Producto

@* Unidad 3 - Partial View: campos del formulario de producto.
   Create y Edit usan los mismos campos; antes estaban repetidos en las dos vistas. *@
<div asp-validation-summary="All" class="text-danger"></div>
<div class="mb-3">
    <label asp-for="Nombre" class="form-label">Nombre</label>
    <input asp-for="Nombre" class="form-control" />
    <span asp-validation-for="Nombre" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Descripcion" class="form-label">Descripción</label>
    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Descripcion" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Precio" class="form-label">Precio ($)</label>
    <input asp-for="Precio" type="number" step="0.01" min="0.01" max="999999.99" class="form-control" />
    <span asp-validation-for="Precio" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="CategoriaID" class="form-label"></label>
    <select asp-for="CategoriaID" asp-items="ViewBag.Categorias" class="form-select">
        <option value="">Seleccione una categoría</option>
    </select>
    <span asp-validation-for="CategoriaID" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Stock" class="form-label"></label>
    <input asp-for="Stock" type="number" min="0" class="form-control" />
    <span asp-validation-for="Stock" class="text-danger"></span>
</div>
<div class="form-check mb-3">
    <input asp-for="Estado" class="form-check-input" />
    <label asp-for="Estado" class="form-check-label">Activo</label>
</div>
