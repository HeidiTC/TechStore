@model List<TechStore.Models.Producto>
@{
    ViewData["Title"] = "Productos";

    // Unidad 3: los botones se muestran según el rol del usuario
    var esAdmin = User.IsInRole("Administrador");
    var puedeEditar = esAdmin || User.IsInRole("Vendedor");
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h2 class="mb-0">Listado de productos <small class="text-muted">(@Model.Count)</small></h2>

    @if (puedeEditar)
    {
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Reportes" asp-action="VerPdf" target="_blank" rel="noopener" class="btn btn-outline-danger">Abrir reporte</a>
            <a asp-controller="Reportes" asp-action="DescargarPdf" class="btn btn-danger">Descargar PDF</a>
            <a asp-controller="Reportes" asp-action="ExportarExcel" class="btn btn-outline-success">Exportar a Excel</a>
            <a asp-action="Create" class="btn btn-primary">Agregar producto</a>
        </div>
    }
</div>

@if (puedeEditar)
{
    @* Unidad 3 - View Component con el resumen del inventario *@
    @await Component.InvokeAsync("ResumenInventario")
}
else
{
    <p class="text-muted">Se muestran solo los productos disponibles para la venta.</p>
}

<div class="table-responsive">
<table class="table table-striped align-middle">
    <thead>
        <tr><th>ID</th><th>Nombre</th><th>Descripción</th><th>Precio</th><th>Categoría</th><th>Stock</th><th>Estado</th><th>Opciones</th></tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ID</td>
            <td>@item.Nombre</td>
            <td class="small">@item.Descripcion</td>
            <td>$@item.Precio.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)</td>
            <td>@item.Categoria?.Nombre</td>
            <td>@item.Stock</td>
            <td>
                @if (item.Estado)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactivo</span>
                }
            </td>
            <td class="text-nowrap">
                <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-outline-primary btn-sm">Ver</a>
                @if (puedeEditar)
                {
                    <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-warning btn-sm">Editar</a>
                }
                @if (esAdmin)
                {
                    <a asp-action="Delete" asp-route-id="@item.ID" class="btn btn-danger btn-sm">Eliminar</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
@if (Model.Count == 0)
{
    <p>No hay productos para mostrar.</p>
}
